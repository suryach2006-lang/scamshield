# =============================================================================
# ScamShield Backend Environment Configuration Template
# Copy this file to 'server/.env' and configure your actual values.
# NEVER commit your real '.env' file or secret credentials to Git.
# =============================================================================

# Server Port (Default: 5000)
PORT=5000

# Node Runtime Environment ('development' | 'production' | 'test')
NODE_ENV=development

# SerpApi Secret Key (Required for live Google Web, Jobs, & News search)
# Obtain a free or paid API key at: https://serpapi.com/
SERPAPI_KEY=your_serpapi_api_key_here

# MongoDB Connection String (Atlas cluster URI or local instance)
# Format for MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster-address>/scamshield?retryWrites=true&w=majority
# Format for Local MongoDB: mongodb://127.0.0.1:27017/scamshield
# Note: If omitted or unreachable, ScamShield automatically operates with an in-memory fallback.
MONGODB_URI=mongodb+srv://suryach2006_db_user:[EMAIL_ADDRESS]/scamshield?retryWrites=true&w=majority
